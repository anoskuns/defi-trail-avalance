# -----------------------------------------------------------------------------
# Public browser configuration
# Values prefixed with NEXT_PUBLIC_ are embedded into the Next.js client bundle.
# Never place private keys or other secrets in this section.
# -----------------------------------------------------------------------------

# HTTPS RPC endpoint for the custom Avalanche Game L1.
NEXT_PUBLIC_GAME_L1_RPC_URL=

# HTTPS RPC endpoint for the Avalanche Fuji C-Chain.
NEXT_PUBLIC_FUJI_C_RPC_URL=

# Avalanche subnet/blockchain identifier for the custom Game L1.
NEXT_PUBLIC_GAME_L1_SUBNET_ID=

# Fixed chain ID for the Avalanche Fuji C-Chain. Do not change for fuji-demo.
NEXT_PUBLIC_FUJI_C_CHAIN_ID=43113

# TeleporterMessenger contract deployed on the Game L1 (0x + 40 hex chars).
NEXT_PUBLIC_GAME_L1_TELEPORTER_MESSENGER_ADDRESS=

# TeleporterMessenger contract deployed on Fuji C-Chain (0x + 40 hex chars).
NEXT_PUBLIC_FUJI_C_TELEPORTER_MESSENGER_ADDRESS=

# Public thirdweb client ID used by the frontend wallet integration.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Optional CARTO key for future premium CARTO data services. The current
# MapLibre basemap uses CARTO's public raster tiles and does not require a key.
NEXT_PUBLIC_CARTO_API_KEY=

# -----------------------------------------------------------------------------
# Server-only configuration
# These values must only be loaded by backend/server code or a secret manager.
# -----------------------------------------------------------------------------

# EIP-712 proof signer private key (0x + 64 hex chars). Never expose to browser.
PROOF_SIGNER_PRIVATE_KEY=


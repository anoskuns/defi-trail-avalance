{
  "name": "defi-trail",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @defi-trail/web dev",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint . --max-warnings=0",
    "test:contracts": "pnpm --filter @defi-trail/contracts-l1 --filter @defi-trail/contracts-cchain run test",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
